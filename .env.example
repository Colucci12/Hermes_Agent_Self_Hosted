# Copie este arquivo para .env e ajuste:
#   copy .env.example .env          (Windows)
#   cp .env.example .env            (Linux)
#
# O .env NÃO vai para o Git. Sem ele o compose não sobe.
# Na VPS compartilhada: não coloque senha de login em texto claro.

# --- Dashboard do Hermes ---
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
# Hash scrypt (não a senha). Gera no PC:
#   docker run --rm --entrypoint python nousresearch/hermes-agent:v2026.9.7 -c "from plugins.dashboard_auth.basic import hash_password; print(hash_password('SUA_SENHA'))"
# Se PASSWORD e PASSWORD_HASH existirem juntos, o Hermes usa a senha em texto. Na VPS deixe só o hash.
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD_HASH=cole-o-hash-aqui
# Só no PC, se quiser testar sem gerar hash:
# HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=localdev
# Segredo de sessão (não é a senha do login). Gere com: openssl rand -hex 32
HERMES_DASHBOARD_BASIC_AUTH_SECRET=troque-isto-tambem

# --- API OpenAI-compatível do Hermes (:8642) ---
# Quem tem esta chave fala com o agente como se fosse você.
# Mínimo 8 caracteres. Gere com: openssl rand -hex 32
API_SERVER_KEY=troque-isto

# --- Modelo de IA ---
# Sem pelo menos UMA chave, tudo sobe mas o agente não responde.
# Dá para colar pelo dashboard (Keys) em vez de deixar aqui.
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# --- Só no home server (docker-compose.homeserver.yml) ---
NOTES_HOST=notes.zvcore.com
HERMES_HOST=hermes.zvcore.com
API_HOST=api.zvcore.com

# Popup do Traefik (Perlite + dashboard). Já é bcrypt, não a senha.
# Gere com: htpasswd -nbB admin SUA_SENHA
# Aspas SIMPLES obrigatórias.
TRAEFIK_BASIC_AUTH_USERS='admin:$2y$10$COLE_O_HASH_AQUI'
